# Copy to .env (untracked) and fill in.
NODE_LABEL=Guest Room
NODE_HOST=192.168.50.200
NODE_MAC=02:00:00:00:00:05
ROUTER_HOST=192.168.50.1
SSH_USER=your-router-login-name
SSH_KEY=~/.ssh/node_radar_ed25519
SSH_PORT=22
POLL_SECONDS=5
# Proximity alert (disabled by default; set NEAR_ALERT=true to use): fire at this RSSI or stronger (avg of last 2 readings); re-arm after it stays
# weaker than REARM_DBM for REARM_SECONDS, or when the device leaves the node.
NEAR_DBM=-50
REARM_DBM=-60
REARM_SECONDS=30
NEAR_ALERT=false
# Roam rule: alert only when a device moves TO the watched node from another node.
ALERT_FRESH_JOIN=false      # also alert when a device joins the network fresh on the watched node
DEBOUNCE_SECONDS=60         # same device alerting again within this many seconds: silent
LOG_MINUTES=30              # how long events.jsonl keeps history (raise, e.g. 1440, for a day)
# Node names: MAC (stable) or LAN IP -> label. Router + 4 nodes (use your own MACs).
NODE_NAMES=02:00:00:00:00:01=Router,02:00:00:00:00:02=Top kitchen,02:00:00:00:00:03=Hallway,02:00:00:00:00:04=Kitchen,02:00:00:00:00:05=Guest Room
